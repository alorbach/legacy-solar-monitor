<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud Auto Backup is also disabled via android:allowBackup="false".
     Explicit excludes keep device-to-device migration from copying Room DB,
     EncryptedSharedPreferences secrets, import copies, and settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
