<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User-entered LAN NAS URLs (http://192.168.x.x) for SBFspot CSV import. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
